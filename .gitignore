# ==============================================================================
# ARGUS — Git Ignore Configuration (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Environment, Cache & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
.env.staging

# Explicitly track the template
!.env.example

# Service account keys and certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
credentials.json
service-account*.json
client_secret*.json

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Logs, Runtime & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# 5. Operating System & IDE Specifics
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ------------------------------------------------------------------------------
# 6. Legacy CallAudio Scratch Directories
# ------------------------------------------------------------------------------
CallAudio/*
!CallAudio/.gitkeep
CallAudio-Archive/*
!CallAudio-Archive/.gitkeep
CallAudio-Failed/*
!CallAudio-Failed/.gitkeep
