# ==============================================================================
# ARGUS — Environment Configuration Template (.env.example)
#
# Copy to .env and adjust for local mock development or GCP live deployment.
# All variables prefixed with ARGUS_ override internal defaults.
# ==============================================================================

# Execution Mode: 'mock' (100% offline, synthetic fixtures) or 'live' (Vertex AI / GCP)
ARGUS_PROVIDER_MODE=mock
ARGUS_ENVIRONMENT=development
ARGUS_PROJECT_ID=argus-compliance-prod
ARGUS_REGION=asia-south1

# Google AI Models (Configurable — never hardcoded)
# Note: May carry -preview suffix in some GCP regions (verify in Phase 2)
ARGUS_GEMINI_FLASH_MODEL=gemini-3.5-flash
ARGUS_GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Cloud Storage Buckets
ARGUS_CALLS_BUCKET=argus-calls-incoming
ARGUS_REGULATIONS_BUCKET=argus-regulations

# Database Configuration (Cloud SQL for MySQL)
ARGUS_DB_USER=root
ARGUS_DB_PASSWORD=your-db-password
ARGUS_DB_NAME=argus
ARGUS_DB_HOST=127.0.0.1
ARGUS_DB_PORT=3306
# Set for Cloud SQL Connector in live Cloud Run mode (e.g. project:region:instance):
# ARGUS_INSTANCE_CONNECTION_NAME=argus-compliance-prod:asia-south1:argus-mysql-primary
# Safety guard: set to false ONLY for live production databases
ARGUS_DB_IS_MOCK=true

# Regulatory File Search Configuration
ARGUS_FS_STRATEGY=chunks
ARGUS_FS_AUTH_MODE=vertex
# ARGUS_GEMINI_API_KEY=your_gemini_api_key_if_using_api_key_mode

# Feature Flags
ARGUS_DLP_ENABLED=true
ARGUS_MODEL_ARMOR_ENABLED=false
ARGUS_FIREBASE_AUTH_ENABLED=false
ARGUS_CLOUD_TASKS_ENABLED=false

# Security & Eventarc Pub/Sub Ingestion
ARGUS_OIDC_AUDIENCE=https://argus-backend-cloudrun-url
ARGUS_ALLOWED_SERVICE_ACCOUNTS=["eventarc-invoker@argus-compliance-prod.iam.gserviceaccount.com"]

# Observability & Distributed Tracing
ARGUS_TRACE_ENABLED=true
ARGUS_CLOUD_TRACE_DEEP_LINK_TEMPLATE=https://console.cloud.google.com/traces/explorer?project={project_id}&tid={trace_id}

# JWT Authentication
ARGUS_JWT_SECRET=your-jwt-secret
ARGUS_JWT_EXPIRATION_HOURS=24

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
